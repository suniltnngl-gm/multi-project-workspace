#!/usr/bin/env sh
# Objective: POSIX entry point for the cross-platform workspace CLI.
# Requirements: Work under sh/bash/zsh on Linux and macOS; find a user-local Node when it is not on PATH.
# Decisions: Keep the shim tiny; all commands, ports, and platform handling live in scripts/workspace-cli.mjs.
# Relevant Files: workspace, workspace.cmd, scripts/workspace-cli.mjs
# Important Context: User file. Windows users should call workspace.cmd instead.
# Work State: Completed: Implemented; Active: None; Blocked: None; Next Move: Maintain as needed.
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if ! command -v node >/dev/null 2>&1; then
  PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"
  for candidate in "$HOME"/.nvm/versions/node/*/bin "$HOME"/.local/share/fnm/node-versions/*/installation/bin; do
    if [ -x "$candidate/node" ]; then
      PATH="$candidate:$PATH"
    fi
  done
  export PATH
fi

if ! command -v node >/dev/null 2>&1; then
  echo 'node is required. Install Node.js 22 or newer and try again.' >&2
  exit 1
fi

exec node "$ROOT_DIR/scripts/workspace-cli.mjs" "$@"
