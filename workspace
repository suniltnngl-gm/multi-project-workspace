#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

WEB_PORT="${WEB_PORT:-5173}"
API_PORT="${PORT:-3001}"
PYTHON_PORT="${PYTHON_PORT:-3002}"
export WEB_PORT API_PORT PYTHON_PORT

# Optional user-local toolchains.
if ! command -v npm >/dev/null 2>&1; then
  NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    # Load a user-local Node installation when npm is not on PATH.
    # shellcheck disable=SC1091
    source "$NVM_DIR/nvm.sh"
  fi
fi

if ! command -v uv >/dev/null 2>&1 && [[ -x "$HOME/.local/bin/uv" ]]; then
  PATH="$HOME/.local/bin:$PATH"
  export PATH
fi

# Colors are enabled only for interactive terminals.
if [[ -t 1 ]]; then
  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_BLUE=$'\033[34m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_RED=$'\033[31m'
else
  C_RESET=''
  C_BOLD=''
  C_BLUE=''
  C_GREEN=''
  C_YELLOW=''
  C_RED=''
fi

log() { printf '%s\n' "$*"; }
info() { printf '%s%s%s\n' "$C_BLUE" "$*" "$C_RESET"; }
success() { printf '%s%s%s\n' "$C_GREEN" "$*" "$C_RESET"; }
warn() { printf '%s%s%s\n' "$C_YELLOW" "$*" "$C_RESET" >&2; }
error() { printf '%s%s%s\n' "$C_RED" "$*" "$C_RESET" >&2; }

# Support a convenience flag for adding/updating one environment value.
if [[ "${1:-}" == "--new-env" ]]; then
  if [[ $# -lt 2 || "$2" != *=* ]]; then
    error 'Usage: ./workspace --new-env "KEY=value"'
    exit 2
  fi
  command_name="env"
  set -- "env" "set" "$2"
fi

command_name="${1:-help}"

require_npm() {
  if ! command -v npm >/dev/null 2>&1; then
    error 'npm is required for this command. Install Node.js/npm first.'
    exit 1
  fi
}

require_uv() {
  UV_BIN="${UV:-uv}"
  if ! command -v "$UV_BIN" >/dev/null 2>&1; then
    error 'uv is required. Install it with: wget -qO- https://astral.sh/uv/install.sh | sh'
    exit 1
  fi
  export UV="$UV_BIN"

  if [[ -n "${VIRTUAL_ENV:-}" ]]; then
    UV_PROJECT_ENVIRONMENT="$VIRTUAL_ENV"
  elif [[ -z "${UV_PROJECT_ENVIRONMENT:-}" ]]; then
    UV_PROJECT_ENVIRONMENT="$ROOT_DIR/apps/python/.venv"
  elif [[ "$UV_PROJECT_ENVIRONMENT" != /* ]]; then
    UV_PROJECT_ENVIRONMENT="$ROOT_DIR/apps/python/$UV_PROJECT_ENVIRONMENT"
  fi
  export UV_PROJECT_ENVIRONMENT
}

run_with_env() {
  exec node "$ROOT_DIR/scripts/with-env.mjs" "$@"
}

install_git_hook() {
  local source_hook="$ROOT_DIR/scripts/hooks/post-commit"
  local target
  target="$(git rev-parse --git-path hooks/post-commit 2>/dev/null)" || {
    warn 'Could not locate the Git hooks directory; skipping the post-commit tracking hook.'
    return 0
  }
  case "$target" in
    /*) ;;
    *) target="$ROOT_DIR/$target" ;;
  esac
  mkdir -p "$(dirname "$target")"
  if [ -f "$target" ] && ! grep -q 'workspace files scan' "$target"; then
    warn 'An existing post-commit hook was left untouched; see scripts/hooks/post-commit to integrate tracking sync manually.'
    return 0
  fi
  cp "$source_hook" "$target"
  chmod +x "$target"
  info 'Installed the post-commit tracking sync hook.'
}

port_in_use() {
  local port="$1"
  (exec 3<>"/dev/tcp/127.0.0.1/${port}") >/dev/null 2>&1
}

check_ports() {
  local port
  for port in "$WEB_PORT" "$API_PORT" "$PYTHON_PORT"; do
    if port_in_use "$port"; then
      error "Port $port is already in use. Stop the existing process or run ./workspace stop."
      return 1
    fi
  done
}

stop_ports() {
  local port stopped=0
  if command -v fuser >/dev/null 2>&1; then
    for port in "$WEB_PORT" "$API_PORT" "$PYTHON_PORT"; do
      if fuser -k "${port}/tcp" >/dev/null 2>&1; then
        stopped=1
      fi
    done
  else
    warn 'fuser is not available; cannot stop processes automatically.'
    return 1
  fi
  if [[ "$stopped" -eq 1 ]]; then
    success 'Stopped processes on ports 5173, 3001, and 3002.'
  else
    info 'No processes were stopped on ports 5173, 3001, or 3002.'
  fi
}

clean_artifacts() {
  rm -rf "$ROOT_DIR/apps/web/dist"
  find "$ROOT_DIR" -type d \( -name '__pycache__' -o -name '.pytest_cache' \) -prune -exec rm -rf {} + 2>/dev/null || true
  success 'Removed frontend build output and Python caches.'
}

print_status() {
  info 'Tool versions:'
  printf '  node: %s\n' "$(command -v node >/dev/null 2>&1 && node --version || echo missing)"
  printf '  npm:  %s\n' "$(command -v npm >/dev/null 2>&1 && npm --version || echo missing)"
  printf '  uv:   %s\n' "$(command -v uv >/dev/null 2>&1 && uv --version || echo missing)"
  printf '  python: %s\n' "$(command -v python3 >/dev/null 2>&1 && python3 --version || echo missing)"
  info 'Service ports:'
  for port in "$WEB_PORT" "$API_PORT" "$PYTHON_PORT"; do
    if port_in_use "$port"; then
      printf '  %s: in use\n' "$port"
    else
      printf '  %s: free\n' "$port"
    fi
  done
}

print_help() {
  printf '%s%sWorkspace commands%s\n\n' "$C_BOLD" "$C_BLUE" "$C_RESET"
  printf 'Usage: ./workspace <command> [arguments]\n\n'
  printf '%sCore%s\n' "$C_BOLD" "$C_RESET"
  printf '  %-24s %s\n' 'dev' 'Start frontend, Node API, and Python satellite'
  printf '  %-24s %s\n' 'web' 'Start only the Vite frontend'
  printf '  %-24s %s\n' 'node, api' 'Start only the Node API'
  printf '  %-24s %s\n' 'python' 'Start only the Python satellite'
  printf '  %-24s %s\n' 'stop' 'Stop processes on the dev service ports'
  printf '  %-24s %s\n' 'restart' 'Stop, then start all services'
  printf '  %-24s %s\n' 'status' 'Show tool versions and service port state'
  printf '\n%sUser files%s\n' "$C_BOLD" "$C_RESET"
  printf '  %-24s %s\n' 'repos list' 'List registered repository roots'
  printf '  %-24s %s\n' 'repos add <path>' 'Register a repository root for tracking'
  printf '  %-24s %s\n' 'files scan' 'Scan user files of every repository and sync headers'
  printf '  %-24s %s\n' 'files list' 'List centrally tracked user files'
  printf '  %-24s %s\n' 'files check' 'Verify every user file is tracked'
  printf '  %-24s %s\n' 'folders scan' 'Scan and register folders in SQLite'
  printf '  %-24s %s\n' 'folders list' 'List centrally tracked folders'
  printf '  %-24s %s\n' 'folders check' 'Verify every folder is tracked'
  printf '  %-24s %s\n' 'git-context scan' 'Scan and track Git worktrees'
  printf '  %-24s %s\n' 'git-context list' 'List tracked Git worktrees'
  printf '  %-24s %s\n' 'git-context check' 'Verify Git worktrees are tracked'
  printf '  %-24s %s\n' 'tools scan' 'Scan and track workflow tools'
  printf '  %-24s %s\n' 'tools list' 'List tracked workflow tools'
  printf '  %-24s %s\n' 'tools check' 'Verify tracked tools are available'
  printf '  %-24s %s\n' 'environment scan' 'Scan and track runtime environment'
  printf '  %-24s %s\n' 'environment list' 'List tracked environment facts'
  printf '  %-24s %s\n' 'environment check' 'Verify environment facts are populated'
  printf '  %-24s %s\n' 'tracks' 'List available tracking domains'
  printf '  %-24s %s\n' '--new-env "KEY=value"' 'Add or update one .env value'
  printf '  %-24s %s\n' 'env set KEY=value ...' 'Add or update .env values'
  printf '  %-24s %s\n' 'env get KEY' 'Read one .env value'
  printf '  %-24s %s\n' 'env list' 'Show .env contents'
  printf '  %-24s %s\n' 'env encrypt [src] [dst]' 'Encrypt .env into .env.enc'
  printf '  %-24s %s\n' 'maintain' 'Run tracking scans and self-check'
  printf '  %-24s %s\n' 'backup' 'Back up the SQLite database'
  printf '  %-24s %s\n' 'env-encrypt [src] [dst]' 'Encrypt a .env file into .env.enc'
  printf '  %-24s %s\n' 'status' 'Show tools, ports, and tracking counts'
  printf '\n%sTasks%s\n' "$C_BOLD" "$C_RESET"
  printf '  %-24s %s\n' 'task worktree <id>' 'Show the worktree linked to a task'
  printf '  %-24s %s\n' 'task worktree create <id>' 'Create and link an isolated task worktree'
  printf '  %-24s %s\n' 'task worktree remove <id>' 'Remove the linked worktree and unlink the task'
  printf '\n%sAI and remote%s\n' "$C_BOLD" "$C_RESET"
  printf '  %-24s %s\n' 'local-ai [all|0.5b|1.5b]' 'Start local models within memory limits'
  printf '  %-24s %s\n' 'colab [status|stop] [session]' 'Inspect or stop the reusable Colab session'
  printf '  %-24s %s\n' 'ai doctor [...]' 'Check local and remote model configuration'
  printf '  %-24s %s\n' 'ai ask [--model ID] ...' 'Ask the running API a direct AI question'
  printf '  %-24s %s\n' 'doctor' 'Alias for ai doctor'
  printf '\n%sDependencies%s\n' "$C_BOLD" "$C_RESET"
  printf '  %-24s %s\n' 'install' 'Install npm dependencies and sync the Python project'
  printf '  %-24s %s\n' 'python-add <pkg...>' 'Add managed Python dependencies with uv'
  printf '  %-24s %s\n' 'python-pip <cmd...>' 'Run uv pip against the workspace Python environment'
  printf '\n%sBuild, test, and quality%s\n' "$C_BOLD" "$C_RESET"
  printf '  %-24s %s\n' 'build' 'Build the frontend'
  printf '  %-24s %s\n' 'build:web' 'Alias for build'
  printf '  %-24s %s\n' 'lint' 'Lint the frontend'
  printf '  %-24s %s\n' 'lint:web' 'Alias for lint'
  printf '  %-24s %s\n' 'test' 'Run frontend, Node, and Python tests'
  printf '  %-24s %s\n' 'test:web' 'Run frontend tests only'
  printf '  %-24s %s\n' 'test:api, test:node' 'Run Node API tests only'
  printf '  %-24s %s\n' 'test:python' 'Run Python tests only'
  printf '  %-24s %s\n' 'check' 'Run lint, tests, and build'
  printf '  %-24s %s\n' 'clean' 'Remove frontend build output and Python caches'
  printf '\n%sExamples%s\n' "$C_BOLD" "$C_RESET"
  printf '  ./workspace dev\n'
  printf '  ./workspace test:api\n'
  printf '  ./workspace local-ai 0.5b\n'
  printf '  ./workspace ai doctor --strict\n'
}

case "$command_name" in
  dev)
    require_npm
    require_uv
    check_ports
    run_with_env npm run dev
    ;;
  web)
    require_npm
    run_with_env npm run dev:web
    ;;
  node|api)
    require_npm
    run_with_env npm run dev:api
    ;;
  python)
    require_uv
    run_with_env "$UV" run --project apps/python python apps/python/src/server.py
    ;;
  local-ai)
    model="${2:-all}"
    run_with_env node "$ROOT_DIR/scripts/local-models.mjs" "$model"
    ;;
  colab)
    run_with_env node "$ROOT_DIR/scripts/colab-session.mjs" "${2:-status}" "${3:-}"
    ;;
  doctor)
    shift || true
    run_with_env node "$ROOT_DIR/scripts/ai-doctor.mjs" "$@"
    ;;
  install)
    require_npm
    require_uv
    npm install
    "$UV" python install "$(cat apps/python/.python-version)"
    install_git_hook
    exec "$UV" sync --project apps/python
    ;;
  python-add)
    require_uv
    if [[ $# -lt 2 ]]; then
      error 'Usage: ./workspace python-add <package> [package ...]'
      exit 2
    fi
    shift
    exec "$UV" add --project apps/python "$@"
    ;;
  python-pip)
    require_uv
    if [[ $# -lt 2 ]]; then
      error 'Usage: ./workspace python-pip <uv-pip-command> [arguments ...]'
      printf 'Example: ./workspace python-pip install <package>\n' >&2
      exit 2
    fi
    shift
    "$UV" sync --project apps/python
    exec "$UV" pip "$@" --python "$UV_PROJECT_ENVIRONMENT/bin/python"
    ;;
  build|build:web)
    require_npm
    run_with_env npm run build
    ;;
  lint|lint:web)
    require_npm
    run_with_env npm run lint
    ;;
  test)
    require_npm
    require_uv
    run_with_env npm test
    ;;
  test:web)
    require_npm
    run_with_env npm run test --workspace apps/web
    ;;
  test:api|test:node)
    require_npm
    run_with_env npm run test --workspace apps/api
    ;;
  test:python)
    require_uv
    PYTHONPATH="$ROOT_DIR/apps/python/src" run_with_env "$UV" run --project apps/python python -m unittest discover -s apps/python/tests
    ;;
  check)
    require_npm
    require_uv
    node "$ROOT_DIR/scripts/with-env.mjs" npm run lint
    "$ROOT_DIR/workspace" test
    ;;
  clean)
    clean_artifacts
    ;;
  status)
    print_status
    info 'Tracking counts:'
    require_uv
    "$UV" run --project apps/python python "$ROOT_DIR/scripts/tracking_status.py"
    ;;
  stop)
    stop_ports
    ;;
  restart)
    stop_ports || true
    require_npm
    require_uv
    check_ports
    run_with_env npm run dev
    ;;
  git-context)
    subcommand="${2:-scan}"
    case "$subcommand" in
      scan)
        require_npm
        shift 2 || true
        run_with_env node "$ROOT_DIR/scripts/scan-git-context.mjs" scan "$@"
        ;;
      list)
        require_npm
        shift 2 || true
        run_with_env node "$ROOT_DIR/scripts/scan-git-context.mjs" list "$@"
        ;;
      check)
        require_npm
        shift 2 || true
        run_with_env node "$ROOT_DIR/scripts/scan-git-context.mjs" check "$@"
        ;;
      *)
        error "Unknown git-context subcommand: $subcommand"
        printf 'Usage: ./workspace git-context [scan|list|check] [--repo NAME]\n' >&2
        exit 2
        ;;
    esac
    ;;
  task)
    subcommand="${2:-}"
    case "$subcommand" in
      worktree)
        action="${3:-show}"
        # A bare numeric argument means "show": ./workspace task worktree <id>
        if [[ "$action" =~ ^[1-9][0-9]*$ ]]; then
          action="show"
        fi
        case "$action" in
          show)
            task_show_id=""
            if [[ "${3:-}" =~ ^[1-9][0-9]*$ ]]; then
              task_show_id="$3"
            elif [[ "${4:-}" =~ ^[1-9][0-9]*$ ]]; then
              task_show_id="$4"
            fi
            if [[ -z "$task_show_id" ]]; then
              error 'Usage: ./workspace task worktree <id>'
              exit 2
            fi
            if ! command -v curl >/dev/null 2>&1; then
              error 'curl is required for task worktree.'
              exit 1
            fi
            if ! port_in_use "$API_PORT"; then
              error "The Node API is not running on port $API_PORT. Start it with ./workspace dev or ./workspace node."
              exit 1
            fi
            task_result="$(curl -sS -w '\n%{http_code}' "http://127.0.0.1:${API_PORT}/api/tasks/${task_show_id}")"
            task_body="${task_result%$'\n'*}"
            task_code="${task_result##*$'\n'}"
            if [[ "$task_code" != "2"* ]]; then
              error "Could not read task #${task_show_id} (HTTP $task_code)."
              exit 1
            fi
            python3 - "$task_body" <<'PY'
import json
import sys

data = json.loads(sys.argv[1])
path = data.get("worktree_path") or ""
print(path if path else "No worktree linked.")
PY
            ;;
          create)
            task_branch=""
            task_name=""
            task_id=""
            shift 3 || true
            while [[ $# -gt 0 ]]; do
              case "$1" in
                --branch)
                  [[ $# -ge 2 ]] || { error 'Usage: ./workspace task worktree create <id> [--branch NAME] [--name NAME]'; exit 2; }
                  task_branch="$2"
                  shift 2
                  ;;
                --name)
                  [[ $# -ge 2 ]] || { error 'Usage: ./workspace task worktree create <id> [--branch NAME] [--name NAME]'; exit 2; }
                  task_name="$2"
                  shift 2
                  ;;
                *)
                  if [[ -z "$task_id" && "$1" =~ ^[1-9][0-9]*$ ]]; then
                    task_id="$1"
                    shift
                  else
                    error "Unknown task worktree option: $1"
                    exit 2
                  fi
                  ;;
              esac
            done
            if [[ -z "$task_id" ]]; then
              error 'Usage: ./workspace task worktree create <id> [--branch NAME] [--name NAME]'
              exit 2
            fi
            if ! command -v curl >/dev/null 2>&1; then
              error 'curl is required for task worktree.'
              exit 1
            fi
            if ! port_in_use "$API_PORT"; then
              error "The Node API is not running on port $API_PORT. Start it with ./workspace dev or ./workspace node."
              exit 1
            fi
            task_payload="$(python3 - "$task_branch" "$task_name" <<'PY'
import json
import sys

branch, name = sys.argv[1], sys.argv[2]
payload = {}
if branch:
    payload["branch"] = branch
if name:
    payload["name"] = name
print(json.dumps(payload))
PY
)"
            task_result="$(curl -sS -w '\n%{http_code}' -X POST "http://127.0.0.1:${API_PORT}/api/tasks/${task_id}/worktree" \
              -H 'Content-Type: application/json' \
              -d "$task_payload")"
            task_body="${task_result%$'\n'*}"
            task_code="${task_result##*$'\n'}"
            if [[ "$task_code" != "2"* ]]; then
              python3 - "$task_body" "$task_code" <<'PY'
import json
import sys

body, code = sys.argv[1], sys.argv[2]
try:
    data = json.loads(body) or {}
except json.JSONDecodeError:
    data = {}
message = data.get("error") or f"The worktree request failed (HTTP {code})."
print(message, file=sys.stderr)
sys.exit(1)
PY
            fi
            python3 - "$task_body" <<'PY'
import json
import sys

data = json.loads(sys.argv[1])
print(f"Linked {data['worktreePath']} (branch {data['branch']}).")
PY
            ;;
          remove)
            task_force=""
            task_id=""
            shift 3 || true
            while [[ $# -gt 0 ]]; do
              case "$1" in
                --force)
                  task_force="1"
                  shift
                  ;;
                *)
                  if [[ -z "$task_id" && "$1" =~ ^[1-9][0-9]*$ ]]; then
                    task_id="$1"
                    shift
                  else
                    error "Unknown task worktree option: $1"
                    exit 2
                  fi
                  ;;
              esac
            done
            if [[ -z "$task_id" ]]; then
              error 'Usage: ./workspace task worktree remove <id> [--force]'
              exit 2
            fi
            if ! command -v curl >/dev/null 2>&1; then
              error 'curl is required for task worktree.'
              exit 1
            fi
            if ! port_in_use "$API_PORT"; then
              error "The Node API is not running on port $API_PORT. Start it with ./workspace dev or ./workspace node."
              exit 1
            fi
            task_result="$(curl -sS -w '\n%{http_code}' -X DELETE "http://127.0.0.1:${API_PORT}/api/tasks/${task_id}/worktree${task_force:+?force=1}")"
            task_body="${task_result%$'\n'*}"
            task_code="${task_result##*$'\n'}"
            if [[ "$task_code" != "2"* ]]; then
              python3 - "$task_body" "$task_code" <<'PY'
import json
import sys

body, code = sys.argv[1], sys.argv[2]
try:
    data = json.loads(body) or {}
except json.JSONDecodeError:
    data = {}
message = data.get("error") or f"The worktree request failed (HTTP {code})."
print(message, file=sys.stderr)
sys.exit(1)
PY
            fi
            python3 - "$task_body" <<'PY'
import json
import sys

data = json.loads(sys.argv[1])
print(f"Removed {data['removedPath']}.")
PY
            ;;
          *)
            error "Unknown task worktree action: $action"
            printf 'Usage: ./workspace task worktree <id>\n' >&2
            printf '       ./workspace task worktree create <id> [--branch NAME] [--name NAME]\n' >&2
            printf '       ./workspace task worktree remove <id> [--force]\n' >&2
            exit 2
            ;;
        esac
        ;;
      *)
        error "Unknown task subcommand: $subcommand"
        printf 'Usage: ./workspace task worktree <id>\n' >&2
        printf '       ./workspace task worktree create <id> [--branch NAME] [--name NAME]\n' >&2
        printf '       ./workspace task worktree remove <id> [--force]\n' >&2
        exit 2
        ;;
    esac
    ;;
  environment)
    subcommand="${2:-scan}"
    case "$subcommand" in
      scan)
        require_uv
        exec "$UV" run --project apps/python python "$ROOT_DIR/scripts/scan_environments.py" scan --database "${DATABASE_PATH:-$ROOT_DIR/apps/api/data/workspace.sqlite}"
        ;;
      list)
        require_uv
        exec "$UV" run --project apps/python python "$ROOT_DIR/scripts/scan_environments.py" list --database "${DATABASE_PATH:-$ROOT_DIR/apps/api/data/workspace.sqlite}"
        ;;
      check)
        require_uv
        exec "$UV" run --project apps/python python "$ROOT_DIR/scripts/scan_environments.py" check --database "${DATABASE_PATH:-$ROOT_DIR/apps/api/data/workspace.sqlite}"
        ;;
      *)
        error "Unknown environment subcommand: $subcommand"
        printf 'Usage: ./workspace environment [scan|list|check]\n' >&2
        exit 2
        ;;
    esac
    ;;
  tools)
    subcommand="${2:-scan}"
    case "$subcommand" in
      scan)
        require_uv
        exec "$UV" run --project apps/python python "$ROOT_DIR/scripts/scan_tools.py" scan --database "${DATABASE_PATH:-$ROOT_DIR/apps/api/data/workspace.sqlite}"
        ;;
      list)
        require_uv
        exec "$UV" run --project apps/python python "$ROOT_DIR/scripts/scan_tools.py" list --database "${DATABASE_PATH:-$ROOT_DIR/apps/api/data/workspace.sqlite}"
        ;;
      check)
        require_uv
        exec "$UV" run --project apps/python python "$ROOT_DIR/scripts/scan_tools.py" check --database "${DATABASE_PATH:-$ROOT_DIR/apps/api/data/workspace.sqlite}"
        ;;
      *)
        error "Unknown tools subcommand: $subcommand"
        printf 'Usage: ./workspace tools [scan|list|check]\n' >&2
        exit 2
        ;;
    esac
    ;;
  folders)
    subcommand="${2:-scan}"
    case "$subcommand" in
      scan)
        require_npm
        shift 2 || true
        run_with_env node "$ROOT_DIR/scripts/scan-folders.mjs" scan "$@"
        ;;
      list)
        require_npm
        shift 2 || true
        run_with_env node "$ROOT_DIR/scripts/scan-folders.mjs" list "$@"
        ;;
      check)
        require_npm
        shift 2 || true
        run_with_env node "$ROOT_DIR/scripts/scan-folders.mjs" check "$@"
        ;;
      *)
        error "Unknown folders subcommand: $subcommand"
        printf 'Usage: ./workspace folders [scan|list|check] [--repo NAME]\n' >&2
        exit 2
        ;;
    esac
    ;;
  repos)
    subcommand="${2:-list}"
    case "$subcommand" in
      list)
        require_npm
        shift 2 || true
        run_with_env node "$ROOT_DIR/scripts/repos.mjs" list
        ;;
      add)
        require_npm
        shift 2 || true
        run_with_env node "$ROOT_DIR/scripts/repos.mjs" add "$@"
        ;;
      *)
        error "Unknown repos subcommand: $subcommand"
        printf 'Usage: ./workspace repos [list|add <path> [--name NAME]]\n' >&2
        exit 2
        ;;
    esac
    ;;
  files)
    subcommand="${2:-scan}"
    case "$subcommand" in
      scan)
        require_npm
        shift 2 || true
        run_with_env node "$ROOT_DIR/scripts/scan-user-files.mjs" scan "$@"
        ;;
      list)
        require_npm
        shift 2 || true
        run_with_env node "$ROOT_DIR/scripts/scan-user-files.mjs" list "$@"
        ;;
      check)
        require_npm
        shift 2 || true
        run_with_env node "$ROOT_DIR/scripts/scan-user-files.mjs" check "$@"
        ;;
      *)
        error "Unknown files subcommand: $subcommand"
        printf 'Usage: ./workspace files [scan|list|check] [--repo NAME]\n' >&2
        exit 2
        ;;
    esac
    ;;
  tracks)
    info 'Tracking domains:'
    printf '  tasks, repositories, user_files, folders, git_worktrees, tools, environments\n'
    info 'Use ./workspace <domain> scan|list|check for each domain.'
    ;;
  self-check)
    info 'Running deterministic workspace self-check...'
    require_npm
    require_uv
    status_code=0
    node "$ROOT_DIR/scripts/with-env.mjs" npm run lint || status_code=1
    node "$ROOT_DIR/scripts/with-env.mjs" npm test || status_code=1
    node "$ROOT_DIR/scripts/with-env.mjs" npm run build || status_code=1
    "$ROOT_DIR/workspace" files check || status_code=1
    "$ROOT_DIR/workspace" folders check || status_code=1
    "$ROOT_DIR/workspace" git-context check || status_code=1
    "$ROOT_DIR/workspace" tools check || status_code=1
    "$ROOT_DIR/workspace" environment check || status_code=1
    node "$ROOT_DIR/scripts/with-env.mjs" node "$ROOT_DIR/scripts/ai-doctor.mjs" --strict || status_code=1
    if [[ "$status_code" -eq 0 ]]; then
      success 'Self-check passed.'
    else
      error 'Self-check found failures.'
    fi
    exit "$status_code"
    ;;
  ai)
    subcommand="${2:-doctor}"
    case "$subcommand" in
      doctor)
        shift 2 || true
        run_with_env node "$ROOT_DIR/scripts/ai-doctor.mjs" "$@"
        ;;
      improve)
        shift 2 || true
        info 'Workspace tracking summary:'
        require_uv
        "$UV" run --project apps/python python "$ROOT_DIR/scripts/tracking_status.py"
        info 'Run ./workspace self-check for deterministic validation.'
        info 'AI improvement prompt:'
        cat <<'PROMPT'
Analyze the workspace tracking summary and repository status. Propose the smallest high-value improvements, prioritized by risk and impact. For each proposal include: title, rationale, affected files, validation commands, and rollback. Do not make changes without approval.
PROMPT
        ;;
      ask)
        shift 2 || true
        ask_model=""
        ask_session=""
        while [[ "$#" -gt 0 ]]; do
          case "$1" in
            --model)
              [[ $# -ge 2 ]] || { error 'Usage: ./workspace ai ask [--model ID] [--session ID] "prompt"'; exit 2; }
              ask_model="$2"
              shift 2
              ;;
            --session)
              [[ $# -ge 2 ]] || { error 'Usage: ./workspace ai ask [--model ID] [--session ID] "prompt"'; exit 2; }
              ask_session="$2"
              shift 2
              ;;
            --*)
              error "Unknown ai ask option: $1"
              exit 2
              ;;
            *)
              break
              ;;
          esac
        done
        if [[ $# -lt 1 || -z "$1" ]]; then
          error 'Usage: ./workspace ai ask [--model ID] [--session ID] "prompt"'
          exit 2
        fi
        if [[ -n "$ask_session" && ! "$ask_session" =~ ^[1-9][0-9]*$ ]]; then
          error 'Session ID must be a positive integer.'
          exit 2
        fi
        if ! command -v curl >/dev/null 2>&1; then
          error 'curl is required for ai ask.'
          exit 1
        fi
        if ! port_in_use "$API_PORT"; then
          error "The Node API is not running on port $API_PORT. Start it with ./workspace dev or ./workspace node."
          exit 1
        fi
        ask_prompt="$1"
        ask_payload="$(python3 - "$ask_prompt" "$ask_model" "$ask_session" <<'PY'
import json
import sys

prompt, model, session = sys.argv[1], sys.argv[2], sys.argv[3]
payload = {"prompt": prompt}
if model:
    payload["model"] = model
if session:
    payload["session_id"] = int(session)
print(json.dumps(payload))
PY
)"
        if ! ask_result="$(curl -sS -w '\n%{http_code}' "http://127.0.0.1:${API_PORT}/api/ai/complete" \
          -H 'Content-Type: application/json' \
          -d "$ask_payload")"; then
          error 'The AI request failed. Check ./workspace ai doctor or the API logs.'
          exit 1
        fi
        ask_body="${ask_result%$'\n'*}"
        ask_code="${ask_result##*$'\n'}"
        if [[ "$ask_code" != "2"* ]]; then
          python3 - "$ask_body" "$ask_code" <<'PY'
import json
import sys

body, code = sys.argv[1], sys.argv[2]
try:
    data = json.loads(body) or {}
except json.JSONDecodeError:
    data = {}
message = data.get("error") or f"The AI request failed (HTTP {code})."
print(message, file=sys.stderr)
if data.get("retryAfter"):
    print(f"Retry after about {data['retryAfter']} seconds.", file=sys.stderr)
sys.exit(1)
PY
        fi
        python3 - "$ask_body" <<'PY'
import json
import sys

data = json.loads(sys.argv[1])
if isinstance(data, dict) and "content" in data:
    print(data["content"])
else:
    print(json.dumps(data))
PY
        ;;
      *)
        error "Unknown ai subcommand: $subcommand"
        printf 'Usage: ./workspace ai doctor [--json] [--strict] [--offline]\n' >&2
        printf '       ./workspace ai improve\n' >&2
        printf '       ./workspace ai ask [--model ID] [--session ID] "prompt"\n' >&2
        exit 2
        ;;
    esac
    ;;
  maintain)
    info 'Running maintenance cycle...'
    require_uv
    "$ROOT_DIR/workspace" files scan
    "$ROOT_DIR/workspace" folders scan
    "$ROOT_DIR/workspace" git-context scan
    "$ROOT_DIR/workspace" tools scan
    "$ROOT_DIR/workspace" environment scan
    "$ROOT_DIR/workspace" self-check
    ;;
  env-encrypt)
    require_uv
    shift || true
    source_path="${1:-.env}"
    destination_path="${2:-.env.enc}"
    WORKSPACE_ENV_KEY="${WORKSPACE_ENV_KEY:-}" "$UV" run --project apps/python python "$ROOT_DIR/scripts/encrypt_env.py" "$source_path" "$destination_path"
    ;;
  backup)
    require_uv
    backup_dir="$ROOT_DIR/apps/api/data/backups"
    mkdir -p "$backup_dir"
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    db_path="${DATABASE_PATH:-$ROOT_DIR/apps/api/data/workspace.sqlite}"
    cp "$db_path" "$backup_dir/workspace-$timestamp.sqlite"
    success "Backed up database to $backup_dir/workspace-$timestamp.sqlite"
    ;;
  env)
    subcommand="${2:-list}"
    case "$subcommand" in
      set)
        shift 2 || true
        if [[ $# -lt 1 ]]; then
          error 'Usage: ./workspace env set KEY=value [KEY=value ...]'
          exit 2
        fi
        env_file="$ROOT_DIR/.env"
        touch "$env_file"
        for assignment in "$@"; do
          if [[ "$assignment" != *=* ]]; then
            error "Invalid assignment: $assignment"
            exit 2
          fi
          key="${assignment%%=*}"
          value="${assignment#*=}"
          if grep -qE "^[[:space:]]*${key}=" "$env_file"; then
            # Replace the existing assignment while preserving other lines.
            python3 - "$env_file" "$key" "$value" <<'PY'
import sys
from pathlib import Path
path = Path(sys.argv[1])
key = sys.argv[2]
value = sys.argv[3]
lines = path.read_text().splitlines()
updated = False
for index, line in enumerate(lines):
    if line.lstrip().startswith(f"{key}="):
        lines[index] = f"{key}={value}"
        updated = True
        break
if not updated:
    lines.append(f"{key}={value}")
path.write_text("\n".join(lines) + "\n")
PY
          else
            printf '%s=%s\n' "$key" "$value" >> "$env_file"
          fi
          success "Set $key in .env"
        done
        ;;
      get)
        key="${3:-}"
        if [[ -z "$key" ]]; then
          error 'Usage: ./workspace env get KEY'
          exit 2
        fi
        env_file="$ROOT_DIR/.env"
        if [[ ! -f "$env_file" ]]; then
          error '.env does not exist.'
          exit 1
        fi
        value="$(grep -E "^[[:space:]]*${key}=" "$env_file" | tail -1)"
        if [[ "$key" =~ (KEY|TOKEN|SECRET|PASSWORD) ]]; then
          printf '%s=***\n' "$key"
        else
          printf '%s\n' "$value"
        fi
        ;;
      list)
        env_file="$ROOT_DIR/.env"
        if [[ ! -f "$env_file" ]]; then
          info '.env does not exist.'
          exit 0
        fi
        while IFS= read -r line; do
          if [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
            key="${BASH_REMATCH[1]}"
            if [[ "$key" =~ (KEY|TOKEN|SECRET|PASSWORD) ]]; then
              printf '%s=***\n' "$key"
            else
              printf '%s\n' "$line"
            fi
          else
            printf '%s\n' "$line"
          fi
        done < "$env_file"
        ;;
      encrypt)
        shift 2 || true
        source_path="${1:-.env}"
        destination_path="${2:-.env.enc}"
        WORKSPACE_ENV_KEY="${WORKSPACE_ENV_KEY:-}" "$UV" run --project apps/python python "$ROOT_DIR/scripts/encrypt_env.py" "$source_path" "$destination_path"
        ;;
      *)
        error "Unknown env subcommand: $subcommand"
        printf 'Usage: ./workspace env [set|get|list|encrypt]\n' >&2
        exit 2
        ;;
    esac
    ;;
  help|-h|--help)
    print_help
    ;;
  *)
    error "Unknown command: $command_name"
    printf 'Run ./workspace help for available commands.\n' >&2
    exit 2
    ;;
esac
