{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curl-ai-bridge.local/schemas/tracking-reconciliation-report.schema.json",
  "title": "Tracking Reconciliation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "scope",
    "summary",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tracking-reconciliation-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "taskIds",
        "selection"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "taskIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "selection": {
          "enum": [
            "explicit_ids",
            "id_range",
            "all_project_tasks"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks",
        "planningRegisters",
        "planningGateEvents",
        "embeddedGatePayloads",
        "events",
        "eventsWithoutToolRun",
        "tasksWithAgentProvenance",
        "dependencyEdges",
        "selfReferences",
        "cycles",
        "findingCount",
        "findingsByCode"
      ],
      "properties": {
        "tasks": {
          "type": "integer",
          "minimum": 0
        },
        "planningRegisters": {
          "type": "integer",
          "minimum": 0
        },
        "planningGateEvents": {
          "type": "integer",
          "minimum": 0
        },
        "embeddedGatePayloads": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "eventsWithoutToolRun": {
          "type": "integer",
          "minimum": 0
        },
        "tasksWithAgentProvenance": {
          "type": "integer",
          "minimum": 0
        },
        "dependencyEdges": {
          "type": "integer",
          "minimum": 0
        },
        "selfReferences": {
          "type": "integer",
          "minimum": 0
        },
        "cycles": {
          "type": "integer",
          "minimum": 0
        },
        "findingCount": {
          "type": "integer",
          "minimum": 0
        },
        "findingsByCode": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "taskId",
          "relatedTaskIds",
          "message",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high"
            ]
          },
          "taskId": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "relatedTaskIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "locator",
              "observedValue"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "locator": {
                "type": "string"
              },
              "observedValue": {}
            }
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
