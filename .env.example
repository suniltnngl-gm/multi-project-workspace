# Copy this file to .env and edit values for your machine.
# Existing shell variables override values from .env.

# Workspace services
PORT=3001
PYTHON_PORT=3002
# HOST=127.0.0.1
# DATABASE_PATH=/absolute/path/to/workspace.sqlite

# Local llama.cpp model servers (0.5B on :8080, 1.5B on :8081)
LOCAL_AI_URL=http://127.0.0.1:8080
LOCAL_AI_1_5B_URL=http://127.0.0.1:8081
LOCAL_AI_CONTEXT=1024
LOCAL_AI_THREADS=2
# LLAMA_SERVER=/path/to/llama-server
# LOCAL_AI_0_5B_PORT=8080
# LOCAL_AI_1_5B_PORT=8081
# LOCAL_AI_0_5B_MODEL=/path/to/Qwen2.5-Coder-0.5B-Instruct-Q4_K_M.gguf
# LOCAL_AI_1_5B_MODEL=/path/to/Qwen2.5-Coder-1.5B-Instruct-Q4_K_M.gguf

# Web models run through the installed CLIs by default: Colab uses a reusable
# session, Kaggle uses the batch notebook runner. Set COLAB_AI_URL or
# KAGGLE_AI_URL to an OpenAI-compatible tunnel to use HTTP instead (faster).
# CLI-backed models are excluded from automatic selection unless
# *_AI_AUTO_SELECT=true, so a request without a model does not spend quota.
# COLAB_AI_SESSION=workspace-qwen
# COLAB_AI_GPU=T4
# Ordered accelerator fallbacks tried when a shape has no capacity, e.g. T4,L4.
# COLAB_AI_GPUS=T4
# COLAB_AI_NEW_RETRIES=1
# COLAB_AI_RETRY_BACKOFF_MS=15000
# Verify the runtime is GPU-backed before downloading weights. A CPU session
# fails fast with gpu_unavailable; set false only for a CPU-capable server.
# COLAB_AI_REQUIRE_GPU=true
# COLAB_AI_GPU_PROBE_TIMEOUT_MS=30000
# COLAB_AI_PORT=8765
# COLAB_AI_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct
# COLAB_AI_BOOTSTRAP_TIMEOUT_MS=1800000
# COLAB_AI_TIMEOUT_MS=900000
# COLAB_AI_AUTO_SELECT=false
# Optional private directory for Colab request/response JSON audit files.
# COLAB_AI_AUDIT_DIR=/tmp/workspace-colab-audit
# KAGGLE_AI_PYTHON=python3
# KAGGLE_AI_POLL_INTERVAL_SECONDS=30
# KAGGLE_AI_TIMEOUT_MS=3600000
# KAGGLE_AI_AUTO_SELECT=false
# Kaggle CLI 2.2.5 has no cancel command. "delete" is an opt-in last resort
# after a non-resumable failure that also deletes the private notebook.
# KAGGLE_AI_CANCEL_FALLBACK=none
# Resumable run manifests and downloaded responses live here. A repeated task
# resumes the recorded kernel instead of spending another submission.
# KAGGLE_AI_MANIFEST_DIR=/tmp/workspace-kaggle-runs

# Optional cross-lane fallback. Move to the next model only on 429/503/504 or
# gpu_unavailable. Session-bound requests stay put unless explicitly allowed.
# AI_FALLBACK_CHAIN=colab-3b>kaggle-3b>local-1.5b
# AI_FALLBACK_ALLOW_SESSIONS=false

# Optional daily request guardrails for quota-backed remote models. Counters
# reset at UTC midnight and persist in SQLite across API restarts. These are
# shorthand for a single fixed requests/day limiter.
# SERVERLESS_AI_MAX_REQUESTS_PER_DAY=20
# COLAB_AI_MAX_REQUESTS_PER_DAY=10
# KAGGLE_AI_MAX_REQUESTS_PER_DAY=5

# Optional billing category per model: free, payg (pay-as-you-go), or
# subscription (monthly subscription). Billing is descriptive only: rate and
# reset quotas apply to every category. Per-model overrides also exist as
# COLAB_AI_BILLING, KAGGLE_AI_BILLING, OPENCODE_AI_BILLING,
# SERVERLESS_AI_BILLING, and OLLAMA_AI_BILLING; a serverless slot can set
# "billing" directly. Local models default to free, web CLI models to free,
# and generic serverless/Ollama endpoints to payg.
# AI_BILLING_CATEGORIES={"opencode":"free","slot-a":"payg","slot-b":"subscription"}

# Optional per-model quota profiles as JSON. A profile is an array of limiters;
# each limiter has unit (requests|tokens|compute_seconds), limit, window
# (second|minute|hour|session|day|week|month|none), reset (rolling|fixed|pool),
# and an optional timezone. Use windowMs or hours for a session window, such as
# hours: 5 for a five-hour reset. A single profile can combine TPS/TPM with
# RPM/RPD and session/daily/weekly windows. Values below are illustrative: use
# your plan's limits, and treat 429/Retry-After as the source of truth. An
# explicit profile overrides that model's daily shorthand.
# AI_QUOTA_PROFILES={"serverless":[{"unit":"tokens","limit":1000,"window":"second","reset":"rolling"},{"unit":"tokens","limit":60000,"window":"minute","reset":"rolling"},{"unit":"requests","limit":30,"window":"minute","reset":"rolling"},{"unit":"requests","limit":1000,"window":"day","reset":"fixed","timezone":"UTC"},{"unit":"requests","limit":5000,"window":"week","reset":"fixed","timezone":"UTC"},{"unit":"requests","limit":300,"window":"session","reset":"fixed","hours":5}]}

# Optional HTTP override for either web model. When set, the CLI backend is
# skipped and the URL is used instead.
# COLAB_AI_URL=https://your-colab-tunnel.example
# COLAB_AI_API_KEY=
# KAGGLE_AI_URL=https://your-kaggle-tunnel.example
# KAGGLE_AI_API_KEY=

# Optional provider-agnostic serverless model (Groq, Google AI Studio,
# OpenRouter, etc.). The client appends CHAT_PATH to URL, so URL must be the
# base that precedes it. Model slugs and vendored endpoints stay here, never in
# source. The slot is registered only when SERVERLESS_AI_URL is set, and it is
# excluded from automatic selection unless AUTO_SELECT=true.
# SERVERLESS_AI_URL=https://api.example.com/openai
# SERVERLESS_AI_API_KEY=
# SERVERLESS_AI_MODEL=provider/model-slug
# SERVERLESS_AI_TIMEOUT_MS=60000
# SERVERLESS_AI_AUTO_SELECT=false
# Optional billing label for the generic slot; defaults to payg.
# SERVERLESS_AI_BILLING=payg
# JSON mode is off by default for new providers; the prompt still asks for JSON.
# SERVERLESS_AI_SUPPORTS_JSON_MODE=false
# Optional path overrides for providers that do not use /v1 suffixes.
# SERVERLESS_AI_CHAT_PATH=/v1/chat/completions
# SERVERLESS_AI_HEALTH_PATH=/v1/models

# Optional additional serverless slots as a JSON array. Each object needs a
# unique id and url; label, apiModel, apiKeyEnv (name of the environment
# variable holding the key), billing (free|payg|subscription), timeoutMs,
# autoSelect, supportsJsonMode, chatPath, healthPath, priority, and limits are
# optional. limits accepts the same per-limiter schema as AI_QUOTA_PROFILES, so
# each slot can carry its own rolling or fixed window. The legacy
# SERVERLESS_AI_URL slot can coexist with
# these entries as long as every id is unique. Credentials stay in environment
# variables; endpoint and model values never enter source.
# SERVERLESS_AI_SLOTS=[{"id":"api-a","label":"API A","url":"https://api-a.example.com/openai","apiKeyEnv":"API_A_KEY","apiModel":"provider/model-a","supportsJsonMode":false,"limits":[{"unit":"requests","limit":30,"window":"minute","reset":"rolling"},{"unit":"tokens","limit":6000,"window":"minute","reset":"rolling"}]},{"id":"api-b","label":"API B","url":"https://api-b.example.com","apiKeyEnv":"API_B_KEY","apiModel":"provider/model-b","limits":[{"unit":"requests","limit":100,"window":"session","reset":"fixed","hours":5}]}]

# Optional Ollama backend (local server or cloud). Registers only when
# OLLAMA_AI_URL or OLLAMA_AI_MODEL is set; OLLAMA_API_KEY alone is treated as
# a credential and never activates the model. Cloud inference requires usage
# credits on the account.
# OLLAMA_AI_URL=https://ollama.com/api
# OLLAMA_AI_MODEL=gpt-oss:120b
# OLLAMA_API_KEY=
# OLLAMA_AI_AUTO_SELECT=false
# OLLAMA_AI_TIMEOUT_MS=120000
# OLLAMA_AI_MAX_REQUESTS_PER_DAY=20

# Optional assistant resource limits (per local model where noted)
# LOCAL_AI_TIMEOUT_MS=120000
# LOCAL_AI_MIN_LOAD=0.5
# LOCAL_AI_MAX_LOAD=1.0
# LOCAL_AI_MIN_AVAILABLE_MEMORY_MB=1024
# LOCAL_AI_1_5B_MIN_AVAILABLE_MEMORY_MB=1792
# LOCAL_AI_MAX_DISK_BUSY_PERCENT=30
# LOCAL_AI_TURN_COOLDOWN_MS=15000

# Optional AI chat limits for POST /api/ai/complete and session-aware drafts.
# AI_MAX_MESSAGES=20
# MAX_AI_SESSION_SUMMARY_CHARS=400
# AI_SESSION_CONTEXT_MESSAGES=10

# Optional universal prompt cache (identical requests return the cached reply).
# AI_PROMPT_CACHE=false
# AI_PROMPT_CACHE_TTL_MS=3600000
# AI_PROMPT_CACHE_MAX_ENTRIES=100

# Optional directory for request/response audit files across all backends.
# AI_AUDIT_DIR=/tmp/workspace-ai-audit

# OpenCode CLI model and billing label. Change the model only between sessions
# so the provider prompt cache is not discarded mid-conversation.
# OPENCODE_AI_MODEL=console-groq/openai/gpt-oss-120b
# OPENCODE_AI_BILLING=free

# OpenCode roster discovery: subprocess timeout, cache TTL, and the offline
# last-good roster file (empty disables persistence).
# OPENCODE_AI_DISCOVERY_TIMEOUT_MS=15000
# OPENCODE_AI_DISCOVERY_TTL_MS=600000
# OPENCODE_AI_ROSTER_CACHE_FILE=apps/api/data/opencode-roster-cache.json

# Agent control plane. The broker is deterministic; these limits bound runs,
# message leases, and checkpoints. A run budget never bypasses provider quota
# or live 429/Retry-After limits. Assignments are also serialized per provider
# quota domain (named backends share one; each serverless slot and Ollama model
# is separate) so a parent cannot fan out work that the provider will reject.
# AGENT_RUN_BUDGET_TOKENS=20000
# AGENT_RUN_BUDGET_CALLS=20
# AGENT_RUN_BUDGET_MS=600000
# AGENT_MAX_PARALLEL_PER_PROVIDER=1
# AGENT_MESSAGE_TTL_MS=300000
# AGENT_MESSAGE_MAX_ATTEMPTS=3
# AGENT_LEASE_MS=30000
# AGENT_CLAIM_LIMIT=10
# AGENT_MAX_CLAIM_LIMIT=20
# AGENT_CHECKPOINT_MAX_BYTES=65536
# Content-addressed agent artifacts live beside the database by default.
# AGENT_ARTIFACT_DIR=/tmp/workspace-agent-artifacts

# Workspace sensors are deterministic and zero-token. Thresholds only decide
# when a detected condition becomes a finding; scans never call a provider.
# SENSOR_STALE_TASK_HOURS=72
# SENSOR_STALE_RUN_HOURS=24
# SENSOR_STALE_METADATA_HOURS=720
# SENSOR_SAMPLE_LIMIT=10
# Improvement cycles are opt-in. The interval is 0 (off) or at least 1000 ms.
# Auto-promotion is off by default; scheduled cycles never run unless enabled.
# SENSOR_CYCLE_INTERVAL_MS=0
# SENSOR_CYCLE_AUTO_PROMOTE=off
# SENSOR_CYCLE_RUN_ON_START=false
# SENSOR_CYCLE_PROJECT=workspace
# SENSOR_CYCLE_TASK_TYPE=chore
