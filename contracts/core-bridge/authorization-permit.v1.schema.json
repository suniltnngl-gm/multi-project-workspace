{
  "type": "object",
  "required": [
    "claims",
    "integrity"
  ],
  "additionalProperties": false,
  "properties": {
    "claims": {
      "type": "object",
      "required": [
        "contractVersion",
        "permitId",
        "issuedAt",
        "expiresAt",
        "audience",
        "taskId",
        "runId",
        "projectId",
        "requestId",
        "idempotencyKey",
        "operation",
        "allowedModelIds",
        "allowedRoles",
        "siblingBindings",
        "localOnly",
        "executionLimits"
      ],
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "1.0"
        },
        "permitId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "issuedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "minLength": 24,
          "maxLength": 24
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "minLength": 24,
          "maxLength": 24
        },
        "audience": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
          "minLength": 2,
          "maxLength": 128
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "minLength": 1,
          "maxLength": 128
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "minLength": 1,
          "maxLength": 128
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "minLength": 1,
          "maxLength": 128
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "minLength": 1,
          "maxLength": 128
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-]{22,128}|[0-9a-f]{32,128})$",
          "minLength": 22,
          "maxLength": 128
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._:-]{1,63}$",
          "minLength": 2,
          "maxLength": 64
        },
        "allowedModelIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "allowedRoles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "parent",
              "reviewer",
              "worker"
            ]
          }
        },
        "siblingBindings": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "modelId",
              "siblingId",
              "role"
            ],
            "additionalProperties": false,
            "properties": {
              "modelId": {
                "type": "string"
              },
              "siblingId": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "parent",
                  "reviewer",
                  "worker"
                ]
              }
            }
          }
        },
        "localOnly": {
          "type": "boolean"
        },
        "executionLimits": {
          "type": "object",
          "required": [
            "maxTurns",
            "maxSiblingCalls",
            "maxTokensPerCall",
            "maxTotalTokens",
            "timeoutSeconds"
          ],
          "additionalProperties": false,
          "properties": {
            "maxTurns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "maxSiblingCalls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "maxTokensPerCall": {
              "type": "integer",
              "minimum": 1,
              "maximum": 131072
            },
            "maxTotalTokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "algorithm",
        "kid",
        "signature"
      ],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "EdDSA"
        },
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "minLength": 1,
          "maxLength": 128
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "minLength": 86,
          "maxLength": 86
        }
      }
    }
  }
}
